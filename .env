# Default configuration for compose.yaml. Compose loads this file automatically;
# variables set in the shell take precedence, e.g.
#   NGENCERF_UI_HOST_PORT=8080 docker compose up --build
# Nothing here is secret. CI and plain `docker build` do not read this file; the
# Dockerfile carries the same defaults for those paths.

# Tag applied to the locally built image. Set to a registry path to publish it.
NGENCERF_UI_IMAGE_NAME=ngencerf-ui:local

# Port published on the host.
NGENCERF_UI_HOST_PORT=3000

# Port the server listens on inside the container (ENV PORT / EXPOSE).
NGENCERF_UI_CONTAINER_PORT=3000

# Working directory inside the image.
WORKDIR_PATH=/var/www/ngencerf/nuxt-app
